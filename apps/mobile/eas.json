{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development" }
    },
    "qa": {
      "distribution": "internal",
      "env": { "APP_ENV": "qa" }
    },
    "uat": {
      "distribution": "internal",
      "env": { "APP_ENV": "uat" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_ENV": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
